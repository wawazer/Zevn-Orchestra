<Window
    x:Class="ZevnShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zevn Shell">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent" BorderThickness="0">
            <Grid Margin="24,0,166,0">
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Border x:Name="BrandMark" Width="17" Height="17" CornerRadius="5">
                        <TextBlock Text="Z" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#04120C" />
                    </Border>
                    <TextBlock x:Name="BrandText" Text="ZEVN" FontSize="11" FontWeight="SemiBold" CharacterSpacing="90"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandText2" Text="SHELL" FontSize="11" CharacterSpacing="90"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TitleText" HorizontalAlignment="Right" FontSize="11" CharacterSpacing="30"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid x:Name="PageHost" Grid.Row="1" />
    </Grid>
</Window>
